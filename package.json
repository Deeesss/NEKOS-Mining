{
  "name": "project_nks",
  "version": "0.1.0",
  "private": true,
  "description": "NEKOS Spice Frontier colony RPG",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env frontier.js",
    "dev": "npm run build && npm start",
    "compile": "node scripts/compile.mjs",
    "deploy:sepolia": "node --env-file-if-exists=.env scripts/deploy-sepolia.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "dev:wallet": "node scripts/local.mjs",
    "start:wallet": "node --env-file-if-exists=.env server.js"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "1.65.1",
    "solc": "0.8.38",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
