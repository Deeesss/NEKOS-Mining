# npm run dev generates isolated local credentials and contracts in data/local/.
# npm start uses Base Sepolia defaults. Set the three deployment-specific values.
# RPC_URL=https://sepolia.base.org
TOKEN_ADDRESS=
REWARDS_ADDRESS=
CLAIM_SIGNER_KEY=
# DEPLOYER_KEY is required only for deploy:sepolia. Use a dedicated test wallet.
DEPLOYER_KEY=
# APP_ORIGIN=http://127.0.0.1:3000
# DATABASE_PATH=data/neko.sqlite
# Spice Frontier local runtime
# FRONTIER_PORT=3000
# FRONTIER_ORIGIN=http://127.0.0.1:3000
# FRONTIER_DATABASE=data/frontier.sqlite
